{
  "name": "brand-it",
  "private": true,
  "workspaces": {
    "packages": ["apps/site", "brand", "skills/brand-it"],
    "catalog": {
      "@types/bun": "1.4.4",
      "opentype.js": "2.0.0",
      "puppeteer-core": "25.16.0",
      "typescript": "7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "check": "oxlint --report-unused-disable-directives && oxfmt --check && bun --filter '*' typecheck",
    "fix": "oxlint --fix; oxfmt",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "ultracite": "8.1.1"
  }
}
